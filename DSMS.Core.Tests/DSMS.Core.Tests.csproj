<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DSMS.Core\DSMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Data\KnownPresets\**\*.json"><Link>Fixtures\KnownPresets\%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
