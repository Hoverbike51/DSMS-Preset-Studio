<Application x:Class="DSMS.PresetStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:DSMS.PresetStudio"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080D16"/>
            <SolidColorBrush x:Key="AppBackgroundImageBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#101927"/>
            <SolidColorBrush x:Key="PanelAltBrush" Color="#162235"/>
            <SolidColorBrush x:Key="InputBrush" Color="#0C1522"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#2A405A"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#23CFE5"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#8B7CFF"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B5C7"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#35D07F"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B942"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF6174"/>
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
            <sys:Double x:Key="AppFontSize">13</sys:Double>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
